<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        android:orientation="vertical">

        <include
            android:id="@+id/includedToolbar"
            layout="@layout/layout_common_toolbar" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_gradient_teal"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvReqHubTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Organ Requests Central"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/tvReqHubTitle"
                android:layout_marginTop="4dp"
                android:text="Separate queues for Pending, Active, and Fulfilled Requests"
                android:textColor="#D1FAE5"
                android:textSize="12sp" />
        </RelativeLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Card 1: Pending Requests -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardNavPendingRequests"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="3dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:padding="16dp">

                        <ImageView
                            android:id="@+id/ivPendingReqIcon"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/ic_request"
                            app:tint="@color/urgent_orange" />

                        <TextView
                            android:id="@+id/tvHubPendingTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_toEndOf="@id/ivPendingReqIcon"
                            android:text="Pending Requests"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvHubPendingCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/tvHubPendingTitle"
                            android:layout_marginStart="14dp"
                            android:layout_marginTop="2dp"
                            android:layout_toEndOf="@id/ivPendingReqIcon"
                            android:text="Count: --"
                            android:textColor="@color/urgent_orange"
                            android:textSize="13sp" />
                    </RelativeLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Card 2: Active Requests -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardNavActiveRequests"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="3dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:padding="16dp">

                        <ImageView
                            android:id="@+id/ivActiveReqIcon"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/ic_inventory"
                            app:tint="@color/status_in_transit" />

                        <TextView
                            android:id="@+id/tvHubActiveTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_toEndOf="@id/ivActiveReqIcon"
                            android:text="Active Requests"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvHubActiveCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/tvHubActiveTitle"
                            android:layout_marginStart="14dp"
                            android:layout_marginTop="2dp"
                            android:layout_toEndOf="@id/ivActiveReqIcon"
                            android:text="Count: --"
                            android:textColor="@color/status_in_transit"
                            android:textSize="13sp" />
                    </RelativeLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Card 3: Fulfilled Requests -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardNavFulfilledRequests"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="3dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:padding="16dp">

                        <ImageView
                            android:id="@+id/ivFulfilledReqIcon"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/ic_heart"
                            app:tint="@color/status_available" />

                        <TextView
                            android:id="@+id/tvHubFulfilledTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_toEndOf="@id/ivFulfilledReqIcon"
                            android:text="Fulfilled Requests"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvHubFulfilledCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/tvHubFulfilledTitle"
                            android:layout_marginStart="14dp"
                            android:layout_marginTop="2dp"
                            android:layout_toEndOf="@id/ivFulfilledReqIcon"
                            android:text="Count: --"
                            android:textColor="@color/status_available"
                            android:textSize="13sp" />
                    </RelativeLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Card 4: Create Request Action -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardNavCreateRequest"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="3dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:padding="16dp">

                        <ImageView
                            android:id="@+id/ivCreateReqIcon"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/ic_search"
                            app:tint="@color/primary" />

                        <TextView
                            android:id="@+id/tvHubCreateTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_toEndOf="@id/ivCreateReqIcon"
                            android:text="Create Organ Requisition"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/tvHubCreateTitle"
                            android:layout_marginStart="14dp"
                            android:layout_marginTop="2dp"
                            android:layout_toEndOf="@id/ivCreateReqIcon"
                            android:text="Submit a new hospital requisition form"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />
                    </RelativeLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </ScrollView>

    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true"
        app:headerLayout="@layout/layout_navigation_drawer_header" />

</androidx.drawerlayout.widget.DrawerLayout>
