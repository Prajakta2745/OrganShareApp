<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5FAF7">

    <!-- Top Branding & Content Container -->
    <LinearLayout
        android:id="@+id/layoutTopBrand"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginTop="56dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <!-- Official Emblem (Hands + Heart + Kidneys) with strict aspect constraints -->
        <ImageView
            android:id="@+id/ivSplashEmblem"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:adjustViewBounds="true"
            android:contentDescription="OrganShare Official Emblem"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_organshare_emblem" />

        <!-- Title: Organ (Green) + Share (Red) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Organ"
                android:textColor="#004D40"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Share"
                android:textColor="#E53935"
                android:textSize="34sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tagline: Give Life • Share Hope -->
        <TextView
            android:id="@+id/tvSplashTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:letterSpacing="0.05"
            android:text="Give Life  •  Share Hope"
            android:textColor="#00695C"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Supporting Message -->
        <TextView
            android:id="@+id/tvSplashSubtitle"
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="Connect donors with those in need. Because every organ matters."
            android:textColor="#334155"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- Bottom Illustration Graphic (Pulse, Reaching Hands & Waves) -->
    <ImageView
        android:id="@+id/ivSplashIllustration"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_alignParentBottom="true"
        android:scaleType="fitXY"
        android:src="@drawable/bg_splash_bottom_illustration" />

    <!-- Loading Container positioned above illustration base -->
    <LinearLayout
        android:id="@+id/layoutLoading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="32dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingEnd="48dp">

        <!-- Real 0-100% Progress Bar -->
        <ProgressBar
            android:id="@+id/pbSplashLoading"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="160dp"
            android:layout_height="6dp"
            android:max="100"
            android:progress="0"
            android:progressBackgroundTint="#80C8E6C9"
            android:progressTint="#004D40" />

        <!-- Status & Percentage Text -->
        <TextView
            android:id="@+id/tvSplashLoadingStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Loading..."
            android:textColor="#E8F5E9"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Error State View (Hidden by default) -->
        <LinearLayout
            android:id="@+id/layoutErrorRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvErrorMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Initialization failed. Please check network."
                android:textColor="#FFCDD2"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSplashRetry"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginTop="6dp"
                android:text="Retry Initialization"
                android:textSize="12sp"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="18dp"
                app:icon="@drawable/ic_refresh"
                app:iconTint="#004D40"
                android:textColor="#004D40" />
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
