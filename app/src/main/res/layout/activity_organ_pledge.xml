<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Header Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_gradient_teal"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="My Organ Donation Pledge"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Select specific organs or pledge full body donation. You can update your pledge preferences anytime."
                    android:textColor="#E0F2FE"
                    android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Disclaimer Banner -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#FEF3C7"
            app:cardCornerRadius="12dp"
            app:strokeColor="#FCD34D"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚖️ Legal &amp; Medical Advisory Notice"
                    android:textColor="#92400E"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Selecting an organ is an expression of your donation registration preference. It does not independently guarantee medical eligibility or future donation, which is subject to clinical suitability evaluation and legal consent at the time of donation."
                    android:textColor="#78350F"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Organ Selection Checklist -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Select Organs You Wish to Pledge:"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <CheckBox
                    android:id="@+id/cbKidney"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Kidneys (Left and Right)"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/cbLiver"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Liver"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/cbHeart"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Heart"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/cbLungs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Lungs"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/cbPancreas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Pancreas"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/cbEyes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Eyes / Corneas"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/cbBoneMarrow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Bone Marrow &amp; Stem Cells"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/cbSmallIntestine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Small Intestine"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:background="#E2E8F0" />

                <CheckBox
                    android:id="@+id/cbFullBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🌟 Full Body Donation (All Eligible Organs &amp; Tissues)"
                    android:textColor="#047857"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Save Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSavePledge"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:text="Save Donation Pledge"
            android:textColor="@color/white"
            android:textSize="16sp"
            app:backgroundTint="@color/primary_teal"
            app:cornerRadius="12dp" />

    </LinearLayout>

</ScrollView>
