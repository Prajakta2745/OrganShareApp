<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.example.organshare">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.OrganShare"
        tools:targetApi="34">

        <!-- Google Maps API Key Placeholder -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="@string/google_maps_key" />

        <!-- Splash / Launcher -->
        <activity
            android:name=".activities.auth.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.OrganShare.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Auth Activities -->
        <activity
            android:name=".activities.auth.LoginActivity"
            android:exported="false" />
        <activity
            android:name=".activities.auth.RegisterActivity"
            android:exported="false" />
        <activity
            android:name=".activities.auth.ForgotPasswordActivity"
            android:exported="false" />

        <!-- Donor Activities -->
        <activity
            android:name=".activities.donor.DonorDashboardActivity"
            android:exported="false" />
        <activity
            android:name=".activities.donor.DonorProfileActivity"
            android:exported="false" />
        <activity
            android:name=".activities.donor.DonationInfoActivity"
            android:exported="false" />

        <!-- Hospital Activities -->
        <activity
            android:name=".activities.hospital.HospitalDashboardActivity"
            android:exported="false" />
        <activity
            android:name=".activities.hospital.CreateRequestActivity"
            android:exported="false" />
        <activity
            android:name=".activities.hospital.RequestDetailsActivity"
            android:exported="false" />
        <activity
            android:name=".activities.hospital.SearchDonorsActivity"
            android:exported="false" />
        <activity
            android:name=".activities.hospital.HospitalOrderDetailsActivity"
            android:exported="false" />
        <activity
            android:name=".activities.hospital.TrackDeliveryMapActivity"
            android:exported="false" />

        <!-- Organ Bank Activities -->
        <activity
            android:name=".activities.organbank.OrganBankDashboardActivity"
            android:exported="false" />
        <activity
            android:name=".activities.organbank.AddEditInventoryActivity"
            android:exported="false" />
        <activity
            android:name=".activities.organbank.AllocateOrganActivity"
            android:exported="false" />
        <activity
            android:name=".activities.organbank.AssignDeliveryActivity"
            android:exported="false" />

        <!-- Delivery Personnel Activities -->
        <activity
            android:name=".activities.delivery.DeliveryDashboardActivity"
            android:exported="false" />
        <activity
            android:name=".activities.delivery.DeliveryDetailsActivity"
            android:exported="false" />
        <activity
            android:name=".activities.delivery.UpdateCheckpointActivity"
            android:exported="false" />

        <!-- Admin Activities -->
        <activity
            android:name=".activities.admin.AdminDashboardActivity"
            android:exported="false" />
        <activity
            android:name=".activities.admin.UserManagementActivity"
            android:exported="false" />
        <activity
            android:name=".activities.admin.AuditLogsActivity"
            android:exported="false" />

        <!-- Common Activities -->
        <activity
            android:name=".activities.common.NotificationsActivity"
            android:exported="false" />

        <!-- Firebase Cloud Messaging Service -->
        <service
            android:name=".notifications.AppFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>

</manifest>
