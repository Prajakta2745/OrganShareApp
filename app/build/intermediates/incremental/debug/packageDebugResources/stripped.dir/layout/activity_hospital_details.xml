<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1E293B">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Hospital Real-Time Details"
            app:titleTextColor="@android:color/white"
            app:navigationIcon="?attr/homeAsUpIndicator" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Hospital Header Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:id="@+id/tvHospitalName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="City Memorial Hospital"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#0F172A" />

                    <TextView
                        android:id="@+id/tvHospitalAddress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="123 Health Ave, Metro City"
                        android:textSize="14sp"
                        android:textColor="#64748B"
                        android:layout_marginTop="4dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="12dp">

                        <TextView
                            android:id="@+id/tvContactPhone"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Phone: +1 555-0199"
                            android:textSize="13sp"
                            android:textColor="#334155" />

                        <TextView
                            android:id="@+id/tvAcceptingStatusBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="● ACCEPTING DONORS"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="#16A34A"
                            android:background="@drawable/bg_badge_normal"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Real-time Bed Availability Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Live Bed Capacity"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1E293B"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- General Beds -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:background="#F1F5F9"
                            android:padding="12dp"
                            android:orientation="vertical">

                            <TextView
                                android:text="General"
                                android:textSize="12sp"
                                android:textColor="#64748B"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>

                            <TextView
                                android:id="@+id/tvGeneralBeds"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="14 / 20"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="#0284C7"
                                android:layout_marginTop="4dp"/>
                        </LinearLayout>

                        <!-- ICU Beds -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:background="#FEF3C7"
                            android:padding="12dp"
                            android:layout_marginStart="8dp"
                            android:orientation="vertical">

                            <TextView
                                android:text="ICU"
                                android:textSize="12sp"
                                android:textColor="#B45309"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>

                            <TextView
                                android:id="@+id/tvIcuBeds"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="4 / 8"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="#D97706"
                                android:layout_marginTop="4dp"/>
                        </LinearLayout>

                        <!-- Emergency Beds -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:background="#FEE2E2"
                            android:padding="12dp"
                            android:layout_marginStart="8dp"
                            android:orientation="vertical">

                            <TextView
                                android:text="Emergency"
                                android:textSize="12sp"
                                android:textColor="#B91C1C"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>

                            <TextView
                                android:id="@+id/tvEmergencyBeds"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="2 / 6"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="#DC2626"
                                android:layout_marginTop="4dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvLastUpdated"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Last updated: Just now"
                        android:textSize="11sp"
                        android:textColor="#94A3B8"
                        android:layout_marginTop="12dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Real-time Blood Stock Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Blood Bank Availability"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1E293B"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:id="@+id/bloodUnitsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvBloodOverview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Live blood inventory units will load here."
                        android:textSize="13sp"
                        android:textColor="#475569" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Fresh Check Notice -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Selecting this hospital triggers a real-time database validation check before confirming donor intake."
                android:textSize="12sp"
                android:textColor="#64748B"
                android:gravity="center"
                android:layout_marginBottom="12dp" />

            <!-- Select Hospital Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSelectHospital"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Select Hospital for Donation"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                android:backgroundTint="#0284C7"
                android:layout_marginBottom="12dp" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
