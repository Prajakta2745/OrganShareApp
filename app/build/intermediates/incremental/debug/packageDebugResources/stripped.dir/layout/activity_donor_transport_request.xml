<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#DC2626">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Emergency / Donor Transport"
            app:titleTextColor="@android:color/white"
            app:navigationIcon="?attr/homeAsUpIndicator" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Hospital Summary Card (Shown during request form) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardHospitalSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:text="Destination Hospital"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#64748B"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/tvDestHospitalName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="City Memorial Hospital"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#0F172A"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Request Form Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRequestForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:text="Pickup Details"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#1E293B"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Pickup Location / Address"
                        android:layout_marginBottom="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPickupAddress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Contact Phone"
                        android:layout_marginBottom="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etContactPhone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="phone" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:text="Urgency Level"
                        android:textSize="13sp"
                        android:textColor="#475569"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp" />

                    <RadioGroup
                        android:id="@+id/rgUrgency"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <RadioButton
                            android:id="@+id/rbNormal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Standard / Scheduled"
                            android:checked="true" />

                        <RadioButton
                            android:id="@+id/rbEmergency"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Critical Emergency"
                            android:layout_marginStart="16dp" />
                    </RadioGroup>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Medical Notes / Special Assistance"
                        android:layout_marginBottom="16dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etNotes"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:lines="2" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSubmitTransport"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="Dispatch Transport Request"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:cornerRadius="10dp"
                        android:backgroundTint="#DC2626" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- DEDICATED SUCCESS & CONFIRMATION VIEW (Shown upon successful dispatch) -->
            <LinearLayout
                android:id="@+id/layoutSuccessScreen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Success Header Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="3dp"
                    app:cardBackgroundColor="#F0FDF4"
                    app:strokeColor="#86EFAC"
                    app:strokeWidth="1.5dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="24dp">

                        <ImageView
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:src="@drawable/ic_check_circle"
                            app:tint="#16A34A" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Request Dispatched Successfully!"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="#166534"
                            android:layout_marginTop="12dp"
                            android:gravity="center" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Your emergency transport request and hospital intake have been registered in the live OrganShare coordination system."
                            android:textSize="13sp"
                            android:textColor="#15803D"
                            android:layout_marginTop="6dp"
                            android:gravity="center" />

                        <TextView
                            android:id="@+id/tvSuccessRequestId"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ticket #TREQ-10A4F8"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#166534"
                            android:background="#DCFCE7"
                            android:paddingStart="12dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="4dp"
                            android:layout_marginTop="12dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Ticket & Driver Dispatch Details Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#E2E8F0"
                    app:strokeWidth="1dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:text="Live Dispatch Details"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#0F172A"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp" />

                        <!-- Destination Hospital -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="8dp">

                            <TextView
                                android:layout_width="120dp"
                                android:layout_height="wrap_content"
                                android:text="Hospital:"
                                android:textSize="13sp"
                                android:textColor="#64748B" />

                            <TextView
                                android:id="@+id/tvSuccessHospitalName"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="City Multispeciality Hospital"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="#0F172A" />
                        </LinearLayout>

                        <!-- Pickup Address -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="8dp">

                            <TextView
                                android:layout_width="120dp"
                                android:layout_height="wrap_content"
                                android:text="Pickup Location:"
                                android:textSize="13sp"
                                android:textColor="#64748B" />

                            <TextView
                                android:id="@+id/tvSuccessPickupLocation"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Shivaji Nagar, Kolhapur"
                                android:textSize="13sp"
                                android:textColor="#0F172A" />
                        </LinearLayout>

                        <!-- Live Status Badge -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="12dp">

                            <TextView
                                android:layout_width="120dp"
                                android:layout_height="wrap_content"
                                android:text="Dispatch Status:"
                                android:textSize="13sp"
                                android:textColor="#64748B" />

                            <TextView
                                android:id="@+id/tvSuccessStatusBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ASSIGNED / DISPATCHED"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="#166534"
                                android:background="#DCFCE7"
                                android:paddingStart="8dp"
                                android:paddingTop="2dp"
                                android:paddingEnd="8dp"
                                android:paddingBottom="2dp" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#E2E8F0"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="12dp" />

                        <!-- Assigned Driver & Unit Info -->
                        <TextView
                            android:text="Assigned Unit &amp; Crew"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#334155"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/tvSuccessVehicleUnit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🚑 Ambulance ALS (Unit #AMB-04)"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#0F172A"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:id="@+id/tvSuccessDriverDetails"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Driver: Ramesh Jadhav (+91-98231-10001)"
                            android:textSize="13sp"
                            android:textColor="#475569"
                            android:layout_marginBottom="12dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCallAssignedDriver"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:text="Call Driver / Coordinator"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            app:cornerRadius="10dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Success Navigation Actions -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReturnToDashboard"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Return to Donor Dashboard"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    android:backgroundTint="#0D9488"
                    android:layout_marginBottom="10dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnViewAvailableHospitals"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="View All Available Hospitals"
                    android:textSize="14sp"
                    app:cornerRadius="12dp"
                    android:layout_marginBottom="24dp" />

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
